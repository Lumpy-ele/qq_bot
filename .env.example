# 应用
APP_NAME=QQ Bot API
APP_VERSION=0.1.0
DEBUG=false

# 日志（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO
LOG_DIR=logs

# 鉴权（阶段 3 启用）
# 调用 /api/v1/send/* 必须携带 Authorization: Bearer <API_KEY>
API_KEY=

# OneBot 协议端
# 本地直跑 uvicorn 时用 127.0.0.1:3000；docker compose 模式下会被
# compose 中的 environment 覆盖为 http://onebot:3000，无需手动改这里
ONEBOT_HTTP_URL=http://127.0.0.1:3000
ONEBOT_TOKEN=

# ---- docker compose 专用 ----
# NapCat 协议端登录的 QQ 小号（首次启动后仍需扫码确认）
# 阶段 0 已验证：3641865272（昵称：口吃长绒大象）
ONEBOT_QQ=3641865272
# NapCat WebUI 鉴权 token（用于首次扫码与查看协议端配置面板）
# 注意：NapCat 每次容器启动会重新生成 token，以 `docker logs qq_bot_onebot` 输出为准
ONEBOT_WEBUI_TOKEN=napcat
